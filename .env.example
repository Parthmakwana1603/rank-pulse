# Frontend settings. Copy this file to .env.local and fill in the values.
# Every VITE_* value is bundled into the browser app, so only public values belong here.
# Leave everything unset to run in demo mode (any login works, sample data, nothing is saved).

# Supabase (see supabase/README.md): Project Settings → API. The anon key is public by design.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# RankPulse API (the Express server in backend/). Required when Supabase is set.
# VITE_API_URL=http://localhost:5000/api
