# Copy this file to .env.local and fill in the values. Leave everything unset to run in demo mode.

# Supabase (see supabase/README.md): Project Settings → API.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of a custom RankPulse REST API (see BACKEND_SPECIFICATION.md). Used for any data
# Supabase doesn't serve yet; leave unset to use the built-in mock data.
# VITE_API_URL=http://localhost:3000/api/v1
