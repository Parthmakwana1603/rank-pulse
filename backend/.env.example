# Copy to backend/.env and fill in. Never commit backend/.env.

# Port the API listens on (the frontend's VITE_API_URL points here, e.g. http://localhost:5000/api).
PORT=5000
NODE_ENV=development

# Supabase project (Project Settings → API). The API verifies each user's access token with
# Supabase Auth and queries the database *as that user*, so row-level security applies.
# Only the public anon key is needed; the service_role key is NOT used by this backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated origins allowed to call the API from a browser (no "*").
CORS_ORIGINS=http://localhost:5173

# Optional: requests per 15 minutes per IP (default 600).
# RATE_LIMIT_MAX=600

# Optional: set when running behind a proxy/load balancer, e.g. 1 (see Express "trust proxy").
# TRUST_PROXY=1

# Testing only: lets the site-audit crawler reach localhost/private IPs. Keep unset in production.
# AUDIT_ALLOW_PRIVATE_HOSTS=true

# Optional, for backend/test/integration.supabase.test.ts only (a throwaway/local project).
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_ANON_KEY=
